# =============================================================================
# MedSociety Marketplace — Environment Variables Template
# =============================================================================
# Copy this file to .env.local (never commit .env.local) and fill in the values.
#
#   cp .env.example .env.local
#
# -----------------------------------------------------------------------------
# FRONTEND KEYS  (bundled into client-side JS by Vite — use VITE_ prefix)
# These are safe to expose in the browser *only* when:
#   • Google Maps API key has HTTP referrer restrictions set in Google Cloud Console
#   • Supabase anon key is paired with Row Level Security (RLS) policies on every table
# -----------------------------------------------------------------------------

# Google Maps JavaScript API (also needs Places API + Geocoding enabled in Cloud Console)
# → https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_MAPS_API_KEY=

# Supabase project URL and anon (public) key
# → https://supabase.com/dashboard/project/<your-project>/settings/api
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# PostHog product analytics. The project API key (phc_…) is public by design.
# → PostHog → Settings → Project → Project API key
# Host: https://us.i.posthog.com (US Cloud) or https://eu.i.posthog.com (EU Cloud).
# In production the browser talks to /ingest (a Vercel rewrite in vercel.json that
# is hard-wired to the US host — change both if the region ever changes).
# Leave the key empty locally to keep dev traffic out of the real project.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# -----------------------------------------------------------------------------
# SERVER-ONLY KEYS  (never use VITE_ prefix — must stay out of the browser bundle)
# Only used by scripts run locally or in CI (e.g. seed-providers.ts)
# -----------------------------------------------------------------------------

# Supabase service-role key (bypasses RLS — NEVER expose to the browser)
# Also used server-side by api/inquiry.ts (patient questions) — set it in Vercel too.
# → https://supabase.com/dashboard/project/<your-project>/settings/api
SUPABASE_SERVICE_ROLE_KEY=

# Cloud Translation API key — a different product from the Maps key above,
# needs its own "Cloud Translation API" enabled in the same (or any) Google
# Cloud project. Used only by scripts/doctoralia/translate-services.ts, to
# translate scraped Spanish service names into English once and cache the
# result on the row — not used anywhere at request time.
# → https://console.cloud.google.com/apis/library/translate.googleapis.com
GOOGLE_TRANSLATE_API_KEY=

# -----------------------------------------------------------------------------
# LEAD NOTIFICATIONS  (server-only — used by api/lead-notify.ts on Vercel)
# Set these in Vercel → Settings → Environment Variables, not just locally.
# -----------------------------------------------------------------------------

# Resend API key for sending the "new listing request" email
# → https://resend.com/api-keys
RESEND_API_KEY=

# Shared secret between the Supabase Database Webhook and api/lead-notify.ts.
# Generate with: openssl rand -hex 32
# Must match the `x-webhook-secret` header configured on the webhook.
LEAD_NOTIFY_SECRET=

# Where new-lead alerts are sent (comma-separated for several recipients)
LEAD_NOTIFY_TO=hello@medsociety.one

# Sender — the domain must be verified in Resend or sends will 403
LEAD_NOTIFY_FROM=MedSociety <leads@medsociety.one>

# -----------------------------------------------------------------------------
# BORDER HEALTH SURVEY → GoHighLevel  (server-only — used by api/borderhealth-lead.ts)
# Set these in Vercel → Settings → Environment Variables, not just locally.
# -----------------------------------------------------------------------------

# Private integration token for the MedSociety GHL (LeadConnector) sub-account.
# Secret — also kept in 1Password (HealthAtlas vault, GHL_PIT_MEDSOCIETY).
GHL_PIT_MEDSOCIETY=

# The MedSociety sub-account's GHL location id. Defaults to HkBNfpRezC5hRkWJaeSx
# in code if left unset here.
GHL_LOCATION_MEDSOCIETY=

# -----------------------------------------------------------------------------
# PAID PLANS  (server-only — used by api/billing.ts on Vercel)
# A GHL workflow POSTs payments to /api/billing with this secret in the
# `x-webhook-secret` header. Also needs GHL_PIT_MEDSOCIETY above, CRON_SECRET
# (shared with api/forum-notify.ts) and the Resend vars from LEAD NOTIFICATIONS.
# Generate with: openssl rand -hex 32
# -----------------------------------------------------------------------------
BILLING_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# PLACE PHOTO PROXY  (server-only — used by api/place-photo.ts on Vercel)
# Set this in Vercel → Settings → Environment Variables, not just locally.
# -----------------------------------------------------------------------------

# Server-side Google Maps API key, distinct from VITE_GOOGLE_MAPS_API_KEY
# above. Needs "Places API (New)" enabled in Google Cloud Console, and must
# be restricted by API (not by HTTP referrer — this key is only ever called
# from the server, so there is no browser origin to restrict to).
# → https://console.cloud.google.com/apis/credentials
# Without this set, home-page tiles fall back to the slower client-side
# Google Maps JS path (src/hooks/useGooglePhotos.ts) instead of this proxy.
GOOGLE_PLACES_SERVER_KEY=

# Salt for the hashed IP in form analytics (api/form-event.ts). Any random string.
FORM_EVENT_SALT=

# OpenRouter: embeddings + Claude for AI symptom search (also reads feedback reports)
OPENROUTER_API_KEY=

# -----------------------------------------------------------------------------
# DOCTOR ANALYTICS  (server-only — used by api/stats.ts on Vercel)
# A nightly job reads profile events from PostHog, rolls them up into Supabase
# (provider_stats_daily) and emails the monthly / weekly reports.
# -----------------------------------------------------------------------------

# A PostHog *personal* API key (not the public phc_ key above) with "Query: read".
# → PostHog → Settings → Personal API keys
POSTHOG_PERSONAL_API_KEY=

# The number in PostHog's URL: https://us.posthog.com/project/<this>/…
POSTHOG_PROJECT_ID=

# https://us.posthog.com (default) or https://eu.posthog.com
POSTHOG_API_HOST=https://us.posthog.com

# Sender for the report emails. Falls back to FORUM_NOTIFY_FROM, then LEAD_NOTIFY_FROM.
STATS_NOTIFY_FROM=

# -----------------------------------------------------------------------------
# AGENT / AUTOMATION API KEYS  (server-only, optional - used by api/agent.ts)
# Comma-separated list, each at least 16 characters (openssl rand -hex 24).
# A key raises the API limits and unlocks the paid symptom search over /api/v1
# and /mcp. Unset = nobody has a key. See docs/agent-integration.md.
# -----------------------------------------------------------------------------
AGENT_API_KEYS=

# -----------------------------------------------------------------------------
# SITE FEEDBACK  (server-only — used by api/feedback.ts on Vercel)
# The Feedback widget (bottom-right of every page) posts here. Every report is
# stored in public.site_feedback (migration 0030); only bugs that pass the
# evidence checks are emailed. Also uses SUPABASE_SERVICE_ROLE_KEY, RESEND_API_KEY,
# LEAD_NOTIFY_FROM / LEAD_NOTIFY_TO, FORM_EVENT_SALT and OPENROUTER_API_KEY above.
# -----------------------------------------------------------------------------

# Where bug alerts go, if not the same inbox as new leads (comma-separated).
FEEDBACK_NOTIFY_TO=
