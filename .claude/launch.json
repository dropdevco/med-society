{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "medsociety-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5174
    },
    {
      "name": "medsociety-dev-alt",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--port",
        "5175",
        "--strictPort"
      ],
      "port": 5175
    },
    {
      "name": "sources-dashboard",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "sources:dashboard"
      ],
      "port": 5180
    },
    {
      "name": "sandbox-proxy",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "tsx",
        "scripts/sources/sandbox/proxy.ts"
      ],
      "port": 54331
    },
    {
      "name": "medsociety-sandbox",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--mode",
        "sandbox",
        "--port",
        "5176",
        "--strictPort"
      ],
      "port": 5176
    }
  ]
}
