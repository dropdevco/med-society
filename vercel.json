{
  "rewrites": [
    {
      "source": "/ingest/static/:path(.*)",
      "destination": "https://us-assets.i.posthog.com/static/:path"
    },
    {
      "source": "/ingest/:path(.*)",
      "destination": "https://us.i.posthog.com/:path"
    },
    {
      "source": "/api/v1",
      "destination": "/api/agent?route=v1"
    },
    {
      "source": "/api/v1/:path*",
      "destination": "/api/agent?route=v1&path=:path*"
    },
    {
      "source": "/mcp",
      "destination": "/api/agent?route=mcp"
    },
    {
      "source": "/api/mcp",
      "destination": "/api/agent?route=mcp"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/agent?route=openapi"
    },
    {
      "source": "/llms.txt",
      "destination": "/api/agent?route=llms"
    },
    {
      "source": "/llms-full.txt",
      "destination": "/api/agent?route=llms-full"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/agent?route=sitemap"
    },
    {
      "source": "/sitemaps/:name",
      "destination": "/api/agent?route=sitemap&name=:name"
    },
    {
      "source": "/",
      "destination": "/api/agent?route=page&kind=home",
      "missing": [
        {
          "type": "header",
          "key": "sec-fetch-dest"
        }
      ]
    },
    {
      "source": "/providers/:id",
      "destination": "/api/agent?route=page&kind=provider&id=:id",
      "missing": [
        {
          "type": "header",
          "key": "sec-fetch-dest"
        }
      ]
    },
    {
      "source": "/pricing",
      "destination": "/api/agent?route=page&kind=pricing",
      "missing": [
        {
          "type": "header",
          "key": "sec-fetch-dest"
        }
      ]
    },
    {
      "source": "/hotels",
      "destination": "/api/agent?route=page&kind=hotels",
      "missing": [
        {
          "type": "header",
          "key": "sec-fetch-dest"
        }
      ]
    },
    {
      "source": "/contact",
      "destination": "/api/agent?route=page&kind=contact",
      "missing": [
        {
          "type": "header",
          "key": "sec-fetch-dest"
        }
      ]
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Permitted-Cross-Domain-Policies",
          "value": "none"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(self), accelerometer=(), camera=(), display-capture=(), encrypted-media=(), gyroscope=(), hid=(), idle-detection=(), magnetometer=(), microphone=(), midi=(), screen-wake-lock=(), serial=(), usb=(), xr-spatial-tracking=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; form-action 'self' https://links.mylayerone.com; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'sha256-iZRFlaxR43W5C7qRmILBdW6uMb3CaZiHN1k4Q6Z+x0w=' 'sha256-daIaCUubuL4Y9KTQBV3rDuttWbKvicXZMLC0iR0GtBk=' https://maps.googleapis.com https://maps.gstatic.com https://t.contentsquare.net https://*.contentsquare.net https://www.clarity.ms https://*.clarity.ms https://links.mylayerone.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://*.googleapis.com https://*.gstatic.com https://*.google.com https://lh3.googleusercontent.com https://s3.us-east-1.amazonaws.com https://pixel-p3.s3.us-east-1.amazonaws.com https://gbfbsecjgjmqoznebwwb.supabase.co https://*.clarity.ms https://*.contentsquare.net; connect-src 'self' https://gbfbsecjgjmqoznebwwb.supabase.co wss://gbfbsecjgjmqoznebwwb.supabase.co https://maps.googleapis.com https://*.clarity.ms https://*.contentsquare.net; frame-src 'self' https://links.mylayerone.com https://www.youtube.com https://www.google.com; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/fonts/:path*",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/.well-known/api-catalog",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/linkset+json"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/.well-known/mcp/server-card.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/forum-notify?job=digest",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/claim-notify?job=drain",
      "schedule": "30 14 * * *"
    },
    {
      "path": "/api/claim-notify?job=review",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/billing?job=sync",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/stats?job=sync",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/stats?job=reports",
      "schedule": "0 15 * * *"
    }
  ]
}
