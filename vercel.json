{
  "rewrites": [
    {
      "source": "/ingest/static/:path*",
      "destination": "https://us-assets.i.posthog.com/static/:path*"
    },
    {
      "source": "/ingest/:path*",
      "destination": "https://us.i.posthog.com/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/forum-notify?job=digest",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/billing?job=sync",
      "schedule": "0 9 * * *"
    }
  ]
}
